# --- Deployer ---
# Burner account only (e.g. MetaMask "Account 2"). Never a wallet holding real assets.
# Needs a small amount of Sepolia ETH for gas.
DEPLOYER_PRIVATE_KEY=0x...

# --- AGENT_ROLE wallet (address only — this script never needs its private key) ---
# The wallet your backend "agent" process will later sign createCommitment() with.
AGENT_WALLET_ADDRESS=0x...

# --- APPROVER_ROLE wallet (address only — this script never needs its private key) ---
# The wallet your backend "approver" process will later sign approveRelease()/revoke() with.
# MUST be a different address from AGENT_WALLET_ADDRESS — the deploy script enforces this.
APPROVER_WALLET_ADDRESS=0x...

# --- Etherscan verification (optional, for `forge verify-contract`) ---
ETHERSCAN_API_KEY=
