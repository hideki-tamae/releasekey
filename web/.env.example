# --- Chain access (server-side only) ---
SEPOLIA_RPC_URL=https://sepolia.gateway.tenderly.co
RELEASEKEY_CONTRACT_ADDRESS=0x56EdE4FbDED72B0e05F3Cc92bD41F98a74549686

# Private keys for the AGENT_ROLE and APPROVER_ROLE wallets granted on the
# deployed contract (see the repo root's DEPLOYER/AGENT/APPROVER setup).
# These are burner keys for the demo only. Never commit real ones.
# MUST resolve to two different addresses — chain.ts refuses to start otherwise.
AGENT_PRIVATE_KEY=0x...
APPROVER_PRIVATE_KEY=0x...

# --- World ID for Agents (sandbox) ---
# Register the client at https://sandbox.auth.world.org/portal
# Redirect URI must exactly match what's registered there.
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=
WORLD_REDIRECT_URI=https://localhost:3010/api/world/callback

# --- JAW.id passkey sign-in (client-side) ---
NEXT_PUBLIC_JAW_API_KEY=

# --- v2: consent policy (SPEC-v2 §3.3) ---
# Optional. The data subject's ENS name whose com.releasekey.policy.* text
# records hold their release policy. Leave empty to use the strict default.
POLICY_ENS_NAME=
